# Copy to .streamlit/secrets.toml for local use, or paste into
# Streamlit Cloud → Manage app → Settings → Secrets.
#
# .streamlit/secrets.toml is gitignored. Never commit a real token.
#
# The token should be a fine-grained PAT scoped to this one repository,
# with Repository permissions → Contents: Read and write.

GITHUB_TOKEN = "github_pat_replace_me"
GITHUB_REPO = "Vaibhavsoni02/website-icon"
GITHUB_BRANCH = "main"
